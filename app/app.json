{
  "expo": {
    "name": "GetFood",
    "slug": "yooo",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCF3E4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abdullah958.getfood"
    },
    "android": {
      "package": "com.abdullah958.getfood",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#E94124",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "androidNavigationBar": {
        "visible": "always",
        "barStyle": "dark-content",
        "backgroundColor": "#FFFFFF"
      },
      "config": {
        "googleMaps": {
          "apiKey": "DUMMY_API_KEY_PREVENT_CRASH"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "61e77707-45e4-4c06-895b-8a7cfc3462aa"
      }
    },
    "owner": "helllloos-team",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GetFood to use your location to find nearby restaurants."
        }
      ],
      "expo-status-bar"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "NEVER",
      "url": "https://u.expo.dev/61e77707-45e4-4c06-895b-8a7cfc3462aa"
    }
  }
}
